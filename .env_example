# Server
PORT=8080
LOG_LEVEL=information

# OpenAI / DeepSeek API (для process_with_ai)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_SYSTEM_PROMPT=From now on, prioritize accuracy over helpfulness. If you don't have reliable information on something, say "I don't have reliable information on this" instead of guessing or extrapolating. If your knowledge might be outdated, explicitly flag it. Don't fill gaps with plausible-sounding answers. Don't assume I want an answer more than I want the truth. Treat "I don't know" as a valid and valuable response. Always answer in Russian.
OPENAI_TIMEOUT=60
OPENAI_SSL_VERIFY=false

# Confluence (load_confluence, parse_confluence) — по умолчанию on-premises Server / Data Center
# CONFLUENCE_URL: базовый URL без слэша в конце (например https://confluence.corp.local или https://wiki.example.com/confluence)
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_USER=service-account
CONFLUENCE_TOKEN=your-personal-access-token-or-password
# server | onprem | datacenter | dc — REST /rest/api (on-prem). cloud | v2 — Atlassian Cloud /wiki/api/v2
CONFLUENCE_API_TYPE=server
CONFLUENCE_TIMEOUT=30
CONFLUENCE_SSL_VERIFY=false
